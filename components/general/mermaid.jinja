<!--Mermaid-->
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>
mermaid.initialize({startOnLoad:false });

window.addEventListener("load", (event) => {
  mermaid.run({
    nodes: document.querySelectorAll('.language-mermaid'),
  });
});

</script>
