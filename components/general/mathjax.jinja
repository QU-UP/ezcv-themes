{# 
    Mathjax is an integration that allows for math formulas in LaTex format
    SEE: https://www.mathjax.org/
#}

<script>
  window.MathJax = {
    loader: {
      load: ['[tex]/texhtml']
    },
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      packages: {'[+]': ['texhtml']},
      processEscapes: true
    }
  };
</script>
<script async
  id="MathJax-script"
  src="https://cdn.jsdelivr.net/npm/mathjax@4.0.0/tex-mml-chtml.js">
</script>